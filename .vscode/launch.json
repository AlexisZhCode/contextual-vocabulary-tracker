{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Start Vocab App (Expo)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["start"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Start Dictionary API",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "api"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
